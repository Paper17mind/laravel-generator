import { createRouter, createWebHistory } from 'vue-router'

const routes = [
  {
    path: '/',
    redirect: '/{{ tables|length > 0 ? tables[0].name : "dashboard" }}'
  },
  {%- for table in tables %}
  {
    path: '/{{ table.name }}',
    name: '{{ table.name }}',
    component: () => import('./components/{{ table.name|capitalize }}.vue')
  },
  {%- endfor %}
]

const router = createRouter({
  history: createWebHistory(),
  routes
})

export default router

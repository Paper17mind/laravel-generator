package main

import (
	"fmt"
	"project/controllers"
	"github.com/gin-gonic/gin"
	"github.com/gin-contrib/cors"
)

func main() {
	r := gin.Default()

	// 🛡️ CORS Middleware
	r.Use(cors.Default())

	// 🔌 Database Initialization Should happen here
	fmt.Println("Initializing {{ project_name }} backend...")

	api := r.Group("/api")
	{
		{%- for table in tables %}
		// Routes for {{ table.name }}
		{{ table.name }}Ctrl := controllers.{{ table.name|capitalize }}Controller{}
		api.GET("/{{ table.name }}", {{ table.name }}Ctrl.Index)
		api.GET("/{{ table.name }}/:id", {{ table.name }}Ctrl.Show)
		api.POST("/{{ table.name }}", {{ table.name }}Ctrl.Store)
		// api.PUT("/{{ table.name }}/:id", {{ table.name }}Ctrl.Update)
		// api.DELETE("/{{ table.name }}/:id", {{ table.name }}Ctrl.Destroy)
		{%- endfor %}
	}

	fmt.Println("🚀 Server starting at :8000")
	r.Run(":8000")
}

<script>
  import { onMount } from 'svelte';
  {% for table in tables %}
  import {{ table.name|capitalize }}Component from './components/{{ table.name|capitalize }}.svelte';
  {% endfor %}

  let activeTab = '{{ tables[0].name if tables|length > 0 else "" }}';
</script>

<div class="flex h-screen bg-slate-100 italic-text">
  <aside class="w-64 bg-slate-900 text-white p-6 shadow-xl">
    <h1 class="text-2xl font-black text-indigo-400 mb-8">{{ project_name }}</h1>
    <nav class="space-y-2">
      {%- for table in tables %}
      <button 
        on:click={() => activeTab = '{{ table.name }}'}
        class="w-full text-left px-4 py-3 rounded-xl transition-all {activeTab === '{{ table.name }}' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:bg-slate-800'}"
      >
        {{ table.name|capitalize }}
      </button>
      {%- endfor %}
    </nav>
  </aside>

  <main class="flex-1 overflow-y-auto p-10">
    {%- for table in tables %}
    {#if activeTab === '{{ table.name }}'}
       <{{ table.name|capitalize }}Component />
    {/if}
    {%- endfor %}
  </main>
</div>

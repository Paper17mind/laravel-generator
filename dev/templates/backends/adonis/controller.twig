import { HttpContextContract } from '@ioc:Adonis/Core/HttpContext'
import {{ resourceUpper }} from 'App/Models/{{ resourceUpper }}'

export default class {{ resourceUpper }}Controller {
  public async index({ response }: HttpContextContract) {
    const data = await {{ resourceUpper }}.all()
    return response.json({ data, message: 'Data retrieved successfully' })
  }

  public async store({ request, response }: HttpContextContract) {
    const data = request.all()
    const {{ resourceCamel }} = await {{ resourceUpper }}.create(data)
    return response.status(201).json({ data: {{ resourceCamel }}, message: 'Resource created successfully' })
  }

  public async show({ params, response }: HttpContextContract) {
    const data = await {{ resourceUpper }}.findOrFail(params.id)
    return response.json({ data })
  }

  public async update({ params, request, response }: HttpContextContract) {
    const data = request.all()
    const {{ resourceCamel }} = await {{ resourceUpper }}.findOrFail(params.id)
    {{ resourceCamel }}.merge(data)
    await {{ resourceCamel }}.save()
    return response.json({ data: {{ resourceCamel }} })
  }

  public async destroy({ params, response }: HttpContextContract) {
    const data = await {{ resourceUpper }}.findOrFail(params.id)
    await data.delete()
    return response.json({ message: 'Deleted' })
  }
}

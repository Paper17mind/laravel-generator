{% set ov = '{{' %}{% set cv = '}}' %}
<template>
  <q-page class="q-pa-md">
    <!-- Header & Tools -->
    <div class="row items-center q-mb-lg q-gutter-sm">
      <div class="col">
        <div class="text-h5 font-bold text-primary">{{ resourceUpper }}</div>
        <div class="text-caption text-grey-7">Manage your {{ resourcePlural }} listing</div>
      </div>
      <div class="col-auto row q-gutter-xs">
        <q-input v-model="filter.search" dense outlined placeholder="Search..." @update:model-value="fetchData" class="bg-white">
          <template v-slot:append><q-icon name="search" /></template>
        </q-input>
        <q-btn icon="event" color="white" text-color="black" label="Dates" unelevated outlined>
          <q-menu>
            <div class="q-pa-md row q-gutter-sm">
              <q-input v-model="filter.start_date" dense type="date" label="From" @change="fetchData" />
              <q-input v-model="filter.end_date" dense type="date" label="To" @change="fetchData" />
            </div>
          </q-menu>
        </q-btn>
        <q-btn color="primary" icon="add" label="Add New" unelevated @click="openModal()" />
      </div>
    </div>

    <!-- Active Filters -->
    <div class="row q-gutter-sm q-mb-md">
      {%- for column in columns %}
      {%- if column.name|slice(-3) == '_id' %}
      <q-select
        v-model="filter.{{ column.name }}"
        :options="{{ column.name|replace({'_id': ''}) }}Options"
        label="{{ column.name|replace({'_id': ''})|title }}"
        dense outlined emit-value map-options clearable
        style="min-width: 150px"
        @update:model-value="fetchData"
      />
      {%- endif %}
      {%- endfor %}
    </div>

    <q-table
      :rows="items"
      :columns="tableColumns"
      row-key="id"
      flat bordered
      :loading="loading"
      v-model:pagination="pagination"
      @request="onRequest"
    >
      <template v-slot:body-cell-actions="props">
        <q-td :props="props" class="text-right">
          <q-btn flat round size="sm" color="primary" icon="edit" @click="openModal(props.row)" />
          <q-btn flat round size="sm" color="negative" icon="delete" @click="deleteItem(props.row.id)" />
        </q-td>
      </template>
    </q-table>

    <!-- Modal Form -->
    <q-dialog v-model="isModalOpen">
      <q-card style="min-width: 450px; border-radius: 12px;">
        <q-form @submit="saveItem">
          <q-card-section class="row items-center q-pb-none">
             <div class="text-h6">{{ ov }} form.id ? 'Edit' : 'Create' {{ cv }} {{ resourceUpper }}</div>
             <q-space /><q-btn icon="close" flat round dense v-close-popup />
          </q-card-section>
          
          <q-card-section class="q-gutter-md">
            {% for column in columns %}
            {% if column.name != 'id' and column.name != 'created_at' and column.name != 'updated_at' and column.name != 'deleted_at' %}
              {% if column.name|slice(-3) == '_id' %}
              <q-select
                v-model="form.{{ column.name }}"
                :options="{{ column.name|replace({'_id': ''}) }}Options"
                label="{{ column.name|replace({'_id': ''})|title }} *"
                filled emit-value map-options
                :rules="[val => !!val || 'Required']"
              />
              {% elseif column.type == 'text' %}
              <q-input v-model="form.{{ column.name }}" label="{{ column.name|title }}" filled type="textarea" />
              {% elseif column.type == 'boolean' %}
              <q-toggle v-model="form.{{ column.name }}" label="{{ column.name|title }}" color="primary" />
              {% elseif column.type == 'date' %}
              <q-input v-model="form.{{ column.name }}" label="{{ column.name|title }}" filled type="date" />
              {% else %}
              <q-input v-model="form.{{ column.name }}" label="{{ column.name|title }}" filled :rules="[val => !!val || 'Required']" />
              {% endif %}
            {% endif %}
            {% endfor %}
          </q-card-section>
          
          <q-card-actions align="right" class="q-pa-md">
            <q-btn label="Cancel" flat color="grey" v-close-popup />
            <q-btn label="Save Changes" color="primary" type="submit" unelevated class="q-px-lg" />
          </q-card-actions>
        </q-form>
      </q-card>
    </q-dialog>
  </q-page>
</template>

<script setup>
import { ref, reactive, onMounted } from 'vue'
import { useQuasar } from 'quasar'

const $q = useQuasar(), items = ref([]), loading = ref(false), isModalOpen = ref(false)
const filter = reactive({ search: '', start_date: '', end_date: '' 
  {%- for column in columns %}{% if column.name|slice(-3) == '_id' %}, {{ column.name }}: null{% endif %}{% endfor %}
})
const pagination = ref({ page: 1, rowsPerPage: 15, rowsNumber: 0 })
const form = reactive({ id: null {% for column in columns %}{% if column.name != 'id' %}, {{ column.name }}: {{ column.type == 'boolean' ? 'false' : "''" }}{% endif %}{% endfor %} })

// Options for Foreign Keys
{%- for column in columns %}
{%- if column.name|slice(-3) == '_id' %}
const {{ column.name|replace({'_id': ''}) }}Options = ref([])
{%- endif %}
{%- endfor %}

const fetchData = async () => {
    loading.value = true
    const params = new URLSearchParams({ page: pagination.value.page, per_page: pagination.value.rowsPerPage, ...filter })
    try {
        const res = await fetch(\`/api/{{ resourcePlural }}?\${params}\`)
        const { data, meta } = await res.json()
        items.value = data
        pagination.value.rowsNumber = meta.total
    } finally { loading.value = false }
}

const fetchOptions = async () => {
    {%- for column in columns %}
    {%- if column.name|slice(-3) == '_id' %}
    try {
        const res = await fetch('/api/{{ column.relasi|split(":")|first|default(column.name|replace({"_id":""}) ~ "s") }}')
        const json = await res.json()
        {{ column.name|replace({'_id': ''}) }}Options.value = json.data.map(i => ({ label: i.name || i.title || i.id, value: i.id }))
    } catch(e) {}
    {%- endif %}
    {%- endfor %}
}

const onRequest = (props) => { pagination.value = props.pagination; fetchData() }

const tableColumns = [
  {% for column in columns %}{ name: '{{ column.name }}', label: '{{ column.name|upper }}', field: '{{ column.name }}', align: 'left', sortable: true },{% endfor %}
  { name: 'actions', label: '', field: 'actions', align: 'right' }
]

const openModal = (item = null) => {
    if (item) Object.assign(form, item)
    else { form.id = null; {% for column in columns %}{% if column.name != 'id' %}form.{{ column.name }} = {{ column.type == 'boolean' ? 'false' : "''" }};{% endif %}{% endfor %} }
    isModalOpen.value = true
}

const saveItem = async () => {
    const method = form.id ? 'PUT' : 'POST'
    const url = form.id ? \`/api/{{ resourcePlural }}/\${form.id}\` : \`/api/{{ resourcePlural }}\`
    await fetch(url, { method, headers: {'Content-Type':'application/json'}, body: JSON.stringify(form) })
    isModalOpen.value = false; fetchData()
}

onMounted(() => { fetchData(); fetchOptions(); })
</script>
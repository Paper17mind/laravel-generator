import React, { useState, useEffect } from 'react';

const {{ resourceUpper }}Management = () => {
    const [items, setItems] = useState([]);

    useEffect(() => {
        fetch('/api/{{ resourcePlural }}')
            .then(res => res.json())
            .then(json => setItems(json.data));
    }, []);

    return (
        <div className="p-6">
            <div className="flex justify-between items-center mb-6">
                <h1 className="text-2xl font-bold">{{ resourceUpper }} Management</h1>
                <button className="px-4 py-2 bg-indigo-600 text-white rounded-lg">Add New</button>
            </div>

            <div className="overflow-x-auto bg-white rounded-xl shadow">
                <table className="w-full text-left">
                    <thead className="bg-gray-50 border-bottom">
                        <tr>
                            {% for column in columns %}
                            <th className="px-6 py-3 text-sm font-semibold text-gray-600">{{ column.name|upper }}</th>
                            {% endfor %}
                            <th className="px-6 py-3 text-sm font-semibold text-gray-600">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody className="divide-y divide-gray-200">
                        {items.map(item => (
                            <tr key={item.id}>
                                {% for column in columns %}
                                <td className="px-6 py-4 text-sm text-gray-700">{item.{{ column.name }}}</td>
                                {% endfor %}
                                <td className="px-6 py-4 text-sm">
                                    <button className="text-indigo-600 hover:underline mr-3">Edit</button>
                                    <button className="text-red-600 hover:underline">Delete</button>
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    );
};

export default {{ resourceUpper }}Management;
